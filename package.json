{
  "name": "ve-urvaki",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Weather-risk operations dashboard for Icelandic tour operators, with a pluggable data-connector layer",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "demo": "DATA_MODE=demo node server/index.js",
    "check": "node scripts/check-connections.js",
    "fixtures": "node scripts/make-fixtures.js",
    "test": "node --test test/*.test.js",
    "start:env": "node --env-file=.env server/index.js",
    "train": "node scripts/train.js",
    "import:outcomes": "node scripts/import-csv.js outcomes",
    "import:bookings": "node scripts/import-csv.js bookings",
    "report": "node scripts/report.js"
  }
}
