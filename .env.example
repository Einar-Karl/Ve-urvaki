# Copy to .env and fill in. Never commit .env (it is git-ignored).
# Run with:  npm run start:env      or      docker compose up -d

PORT=8080

# --- Access control (REQUIRED once this runs anywhere other than your own laptop) ---
DASHBOARD_PASSWORD=
DASHBOARD_USER=arctic
# Lets other programs (Zapier, scripts) POST to /api/ingest/* with header  x-api-key: <token>
INGEST_TOKEN=

# --- Weather ---
# MET Norway requires an identifying User-Agent with a contact address:
VEDURVAKI_UA=Vedurvaki/0.3 you@arcticadventures.example
# Paid Open-Meteo key (REQUIRED for commercial use; the free tier is non-commercial only):
OPENMETEO_API_KEY=

# --- Bookings (Bókun) ---
BOKUN_ACCESS_KEY=
BOKUN_SECRET_KEY=
# Only change if Bókun tells you a different host:
# BOKUN_BASE=https://api.bokun.io

# --- Roads (Vegagerðin DATEX II) ---
# Service URL from https://vegagerdin.is/vegagerdin/gagnasafn/vefthjonustur/datexii-2
VEGAGERDIN_DATEX_URL=
# VEGAGERDIN_AUTH=

# --- Behaviour ---
# auto = live data, fall back to labelled demo data if no source answers; live = never fall back
DATA_MODE=auto
# 1 = retrain cancellation thresholds every night from recorded decisions
AUTO_TRAIN=1
