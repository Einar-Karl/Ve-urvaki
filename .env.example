# Copy to .env and fill in. Never commit .env (it is git-ignored).
# Run with:  npm run start:env      or      docker compose up -d

PORT=8080
# The public address guests will open. REQUIRED for guest messages (links in SMS/email point here).
PUBLIC_BASE_URL=https://vedur.arcticadventures.example

# --- Access control (REQUIRED once this runs anywhere other than your own laptop) ---
DASHBOARD_PASSWORD=
DASHBOARD_USER=arctic
# Separate login for /admin (recommended). If empty, the dashboard login also opens the admin page.
ADMIN_PASSWORD=
ADMIN_USER=admin
# Simple shared key for programs posting to /api/ingest/*. Prefer per-program keys created in Admin → Partners.
INGEST_TOKEN=

# --- Weather (several models are combined; their disagreement widens the stated uncertainty) ---
# MET Norway requires an identifying User-Agent with a contact address:
VEDURVAKI_UA=Vedurvaki/0.4 you@arcticadventures.example
# Paid Open-Meteo key (REQUIRED for commercial use; the free tier is non-commercial only):
OPENMETEO_API_KEY=
# Individual models fetched through Open-Meteo, each a separate "vote". Empty = only best-match.
OPENMETEO_MODELS=ecmwf_ifs025,icon_seamless,gfs_seamless
# Optional extra source (OpenWeatherMap One Call 3.0 subscription needed):
OPENWEATHER_API_KEY=

# --- Roads and stations: Vegagerðin open data works without keys ---
# Override only if Vegagerðin changes a URL:
# VEGAGERDIN_ROADS_URL=https://gagnaveita.vegagerdin.is/api/faerd2017_1
# VEGAGERDIN_STATIONS_URL=https://gagnaveita.vegagerdin.is/api/vedur2014_1
# Optional DATEX II publication:
# VEGAGERDIN_DATEX_URL=

# --- Bookings (Bókun) ---
BOKUN_ACCESS_KEY=
BOKUN_SECRET_KEY=
# BOKUN_BASE=https://api.bokun.io

# --- Guest messaging ---
# dry-run (default): messages are written to the outbox, NOT sent.  live: really send SMS/email.
MESSAGING_MODE=dry-run
# SMS via Twilio (From = a number or an alphanumeric sender id, or use a Messaging Service SID instead)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# TWILIO_MESSAGING_SERVICE_SID=
# Email via Resend (domain must be verified in Resend)
RESEND_API_KEY=
EMAIL_FROM=Arctic Adventures <bookings@arcticadventures.example>

# --- Behaviour ---
# auto = live data, fall back to labelled demo data if no source answers; live = never fall back
DATA_MODE=auto
# 1 = retrain cancellation thresholds every night from recorded decisions
AUTO_TRAIN=1
